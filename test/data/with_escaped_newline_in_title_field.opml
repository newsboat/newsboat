        <title>Example OPML with a hidden newline in the `title` field</title>
    </head>

    <body>
    <outline type="rss"
             xmlUrl="http://example.org/feed2.xml"
             title="demo&#10;exec:echo${IFS}oops"/>
    </body>
</opml>
