<?xml version="1.0" encoding="UTF-8"?>
<opml version="1.0">
    <head>
        <title>Example OPML that has a URL that starts with exec:</title>
    </head>

    <body>
        <outline type="rss" title="My little exploit" xmlUrl="exec:echo You have been pwnd" />
        <outline title="tagged">
            <outline xmlUrl="https://example.com/feed.atom" type="rss" title="Normal feed" />
        </outline>
    </body>
</opml>
